# ============================================================
# AccountTools 本地配置(复制为 .env 后按需修改;.env 已被 gitignore,不会入库)
#
# 设计说明:本项目的所有账号凭据都不存放在仓库里——
#   各平台凭据只存于本机各应用的私有目录(如 ~/.workbuddy/、
#   ~/Library/Application Support/...),由切号脚本运行时直接读写。
# 因此 .env 只用于本地运行偏好,不存在"必须提交的密钥"。
# ============================================================

# SignCenter 控制台监听端口(默认 8800)
SIGNCENTER_PORT=8800

# SignCenter 管理的 Trae 版本:cn = Trae CN(国内版),intl = Trae(国际版)
TRAE_PROFILE=cn
